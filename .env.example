# Скопируйте в .env при локальном запуске (для docker-compose значения уже заданы в docker-compose.yml).

API_KEY=supersecret-api-key

# Для запуска вне docker используйте localhost вместо имён сервисов.
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Эмуляция обработки
PROCESS_DELAY_MIN=2.0
PROCESS_DELAY_MAX=5.0
SUCCESS_RATE=0.9

# Webhook retry
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_BASE=1.0
WEBHOOK_TIMEOUT=10.0

# Outbox relay
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100
